# MacroMicro API Configuration
# Copy this file to .env and fill in your actual API endpoint

MacroMicro_API=https://your-macromicro-api-endpoint-here

# ChatGPT App Configuration
# The public URL where this app is hosted (for widget serving)
# This should be the HTTPS URL where ChatGPT can access the widget
APP_BASE_URL=https://your-app-url-here
